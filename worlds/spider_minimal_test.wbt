#VRML_SIM R2023b utf8

WorldInfo {
  info [
    "Minimal Spider Robot Test"
  ]
  title "Spider Static Test"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.3 0.9 0.3 1.2
  position 0.4 0.3 0.4
}

Background {
  skyColor [
    0.4 0.7 1.0
  ]
}

DirectionalLight {
  ambientIntensity 1
  direction 0.1 -0.5 0.3
}

DEF FLOOR Solid {
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.8 0.8
        }
      }
      geometry Plane {
        size 2 2
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 2 2
  }
}

# Simple test robot without PROTO first
Robot {
  translation 0 0.1 0
  children [
    # Body
    Solid {
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.3 0.3 0.3
            }
          }
          geometry Box {
            size 0.12 0.04 0.08
          }
        }
      ]
      name "body"
    }
    
    # Single test leg to debug
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor 0.06 0 0.04
      }
      device [
        RotationalMotor {
          name "test_motor"
          maxTorque 2.0
        }
      ]
      endPoint Solid {
        translation 0.06 0 0.04
        rotation 0 0 1 1.5708
        children [
          Shape {
            appearance Appearance {
              material Material {
                diffuseColor 0.8 0.2 0.2
              }
            }
            geometry Cylinder {
              height 0.04
              radius 0.015
            }
          }
        ]
        name "test_leg"
      }
    }
  ]
  name "TestRobot"
  controller "spider_static"
}
