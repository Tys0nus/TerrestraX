#VRML_SIM R2023b utf8

WorldInfo {
  info [
    "Full Spider Robot Test - Inline Definition"
  ]
  title "Spider Full Test"
  basicTimeStep 32
}

Viewpoint {
  orientation -0.3 0.9 0.3 1.2
  position 0.4 0.3 0.4
}

Background {
  skyColor [
    0.4 0.7 1.0
  ]
}

DirectionalLight {
  ambientIntensity 1
  direction 0.1 -0.5 0.3
}

DEF FLOOR Solid {
  children [
    Shape {
      appearance Appearance {
        material Material {
          diffuseColor 0.8 0.8 0.8
        }
      }
      geometry Plane {
        size 2 2
      }
    }
  ]
  name "floor"
  boundingObject Plane {
    size 2 2
  }
}

# Full spider robot without PROTO (inline definition)
Robot {
  translation 0 0.1 0
  children [
    # Body
    Solid {
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.3 0.3 0.3
            }
          }
          geometry Box {
            size 0.12 0.04 0.08
          }
        }
      ]
      name "body"
    }
    
    # Front Left Leg (Leg 0)
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor 0.06 0 0.04
      }
      device [
        RotationalMotor {
          name "coxa_motor_0"
          maxTorque 2.0
        }
        PositionSensor {
          name "coxa_sensor_0"
        }
      ]
